# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/productivity_tracker

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Cookies
COOKIE_SECURE=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# AI Assistant (provider-agnostic; leave AI_PROVIDER=none to disable).
# Currently supported: "none" | "gemini" (Google Gemini, via plain REST - no SDK).
# Get a key at https://aistudio.google.com/apikey - AI_MODEL defaults to the
# "gemini-flash-latest" alias if left blank, which Google keeps pointed at
# its current Flash release so this never silently breaks on model retirement.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Notifications (provider-agnostic; leave NOTIFICATION_PROVIDER=in_app for DB-only notifications)
NOTIFICATION_PROVIDER=in_app
PUSH_PROVIDER_KEY=
EMAIL_PROVIDER_KEY=

# Logging
LOG_LEVEL=info
