# Base URL of the backend API, including the "/api" prefix.
# Leave unset for local dev - Vite's dev-server proxy forwards the default
# "/api" to http://localhost:5000 (see vite.config.ts).
# Required only when the frontend and backend are deployed to different
# origins (e.g. this app on Vercel, the API on Render) - Vite bakes env
# vars into the build at build time, so setting this in your host's
# dashboard requires a rebuild/redeploy to take effect.
VITE_API_URL=https://your-backend.onrender.com/api
